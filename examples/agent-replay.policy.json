{
  "mustCall": ["shell"],
  "mustNotCall": ["send_message"],
  "maxShellCalls": 2,
  "maxDurationMs": 1000,
  "noFailedTools": true,
  "mustEndOk": true,
  "forbiddenSideEffects": ["external-state"],
  "maxSideEffectCalls": {
    "network": 1
  },
  "mustUseArgs": [
    {
      "tool": "shell",
      "args": {
        "command": "npm test"
      }
    }
  ],
  "forbiddenCommandPrefixes": ["rm -rf", "git reset --hard"],
  "requiredOrder": ["shell"]
}
